# Скопируйте в .streamlit/secrets.toml (файл не попадает в git) или задайте переменные окружения.

# Источник данных: duckdb (по умолчанию, синтетика) или mysql
DATA_BACKEND = "duckdb"
# MYSQL_URL = "mysql+pymysql://user:password@host:3306/retail_bi?charset=utf8mb4"

# Показывать реальные названия сетей вместо «Сеть А / Сеть Б» (только для закрытого контура)
SHOW_REAL_NAMES = "0"

# Любая другая СУБД через SQLAlchemy (PostgreSQL, ClickHouse, MS SQL — нужен драйвер)
# DATA_BACKEND = "sql"
# SQL_URL = "postgresql+psycopg://user:password@host:5432/retail_bi"

# Ссылки для переключения между опубликованными версиями прототипа
# V1_URL = "https://app-bi-jbpazcgjfwtjmhtebvab9h.streamlit.app/"
# V2_URL = "https://retail-bi-v2.streamlit.app/"
