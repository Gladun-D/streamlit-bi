# Скопируйте в .streamlit/secrets.toml (файл не попадает в git) или задайте переменные окружения.

# Источник данных: duckdb (по умолчанию, синтетика) или mysql
DATA_BACKEND = "duckdb"
# MYSQL_URL = "mysql+pymysql://user:password@host:3306/retail_bi?charset=utf8mb4"

# Показывать реальные названия сетей вместо «Сеть А / Сеть Б» (только для закрытого контура)
SHOW_REAL_NAMES = "0"
